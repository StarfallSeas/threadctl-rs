// threadctl-rs — KDL 配置示例（P6.3：cluster 支持 mid + 同档 fallback）
//
// 使用方法：
//   ./threadctl -c threadctl.kdl
//
// 语法说明：
//   - 字符串用双引号 "..."；// 单行注释
//   - default / thread / thread-type 内可设：cpus、cluster、sched、priority、nice、uclamp-min、uclamp-max
//   - cluster 自动从 cpu_capacity 检测：little / mid / big / prime
//     · SM8550/SM8475（3 组）：little / big / prime（无 mid）
//     · SM8650（4 组）：little / mid / big / prime
//     · SM8750/SM8850（2 组全大核）：big / prime（无 little/mid）
//   - cluster 设备上不存在时 → 同档近似 fallback + 告警（不静默）：
//     little/mid → big；big/prime → prime
//   - cpus 接受数字范围："0-6"、"7"、"4-7" —— 想指定具体 CPU 用 cpus
//   - thread-type 内置别名：render→*RenderThread*,*GL*,*Vk*；audio→*Audio*,*Sound*；binder→*Binder:*；main→*main*
//   - priority 配合 sched fifo/rr，自动合并为 "fifo:60"
//   - 本仓库不内置默认规则——以下均为示例，按需复制进自己的配置

// ────────────────────────────── 守护进程 ──────────────────────────────
daemon {
    pid-file "./run/threadctl.pid"
    ipc-socket "./run/threadctl.sock"
    log-level "info"            // trace | debug | info | warn | error
}

// ────────────────────────────── 引擎 ──────────────────────────────
engine {
    mode "auto"                 // auto | ebpf | proc | hybrid
    scan-interval 2             // 秒；/proc 轮询间隔
    lock-interval 60            // 秒；周期重锁定。0=仅事件驱动（对抗 AMS 覆盖建议设 60）
    dead-cleanup-interval 15    // 秒；死进程清理
    migrate-action "observe"    // observe | suggest | force（sched_switch 迁移观察）
    pressure-sensitive "true"   // 系统压力是否下调策略强度（KDL 布尔用引号字符串或 #true）
}

// ────────────────────────────── APP 规则 ──────────────────────────────

// ============ 微信（示例模板） ============
// app "com.tencent.mm" {
    // 默认：所有未单独命名的线程放 big 集群
    // default {
        // cluster "big"
    // }
    // 精确线程名：渲染线程上 prime
    // thread "RenderThread" {
        // cluster "prime"
        // sched "fifo"
        // priority 60
    // }
    // 通配匹配：所有 Audio* 线程上 little，压低 nice
    // thread "Audio:*" {
        // cluster "little"
        // nice -5
    // }
// }

// ============ 原神 ============
app "com.miHoYo.Yuanshen" {
    // 整个游戏进程用全部性能核
    default {
        cluster "big"
    }
    // Unity 主渲染线程锁 prime
    thread "UnityMain" {
        cluster "prime"
        sched "fifo"
        priority 10
    }
    // 线程类型别名：所有 render 类型线程
    thread-type "render" {
        cluster "big"
    }
}

// ============ 抖音（P6.3 示例：cpus 直达，防 AMS/自研线程管理干扰） ============
// app "com.ss.android.ugc.aweme" {
    // default {
        // cpus "0-7"
    // }
    // thread "RenderThread" {
        // cpus "3-7"
        // sched "fifo"
        // priority 60
        // nice -10
    // }
    // 注意：抖音部分版本会自行重设线程亲和性，与外部策略对抗属正常现象
// }

// ============ 酷安 ============
app "com.coolapk.market" {
    default {
        cluster "big"
    }
    thread "RenderThread" {
        cluster "prime"
        sched "fifo"
        priority 60
        nice -10
    }
}

// ============ 系统桌面 ============
// 指定具体 CPU 范围用 cpus（比 cluster 更精确）
app "com.miui.home" {
    default {
        cpus "0-6"
    }
    thread "RenderThread" {
        cpus "7"
        sched "fifo"
        priority 60
        nice -10
    }
    thread "com.miui.home" {
        cpus "3-6"
        sched "fifo"
        priority 60
        nice -10
    }
}

// ============ 网易云音乐（后台常驻、需保活 + 低功耗） ============
app "com.netease.cloudmusic" {
    // 音频线程保持 big 保证流畅，其余线程返回 little 省电
    thread-type "audio" {
        cluster "big"
        sched "rr"
        priority 30
    }
    default {
        cluster "little"
    }
}

// ============ SM8650（骁龙 8 Gen 3，4 组）mid 示例 ============
